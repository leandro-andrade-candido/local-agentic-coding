#!/usr/bin/env bash
# llm: the local llama-server as a user service (E5). See docs/stages/E5-preparation.md.
#
# Usage: scripts/llm <command>
#   key                  creates the key (~/.config/local-agentic/llm-api-key, mode 0600) if it
#                        does not exist; prints the path, never the key
#   install [--enable] [--dry-run]
#                        writes the unit to ~/.config/systemd/user and runs daemon-reload;
#                        --enable also starts it with the session; --dry-run only shows
#   uninstall            stops, disables and removes the unit (the key stays)
#   start | stop | restart | status
#                        start and restart run the preflight first and wait for the model to load
#   logs [-f] [-n N]     unit journal (default: last 200 lines)
#   health               /health, /v1/models and a 1-token chat (latency), and checks the
#                        policy on the server: key required, CORS, /props, /slots, /tools
#   preflight            scripts/preflight.sh
#   dry-run              final command line, without starting (runtime/llama-server-start.sh --dry-run)
#   model [<alias>|--reset]
#                        no argument: lists the models in models.tsv (installed? in use?);
#                        with an alias: saves the choice (takes effect on the next start/restart);
#                        --reset: back to the profile default. The API name does not change.
#   env                  export lines for the agents: eval "$(scripts/llm env)"
#   test [options]       scripts/tool_calls.py against the server, JSON in logs/tool_calls-<date>.json
#   wait-ready [--timeout S]
#                        waits for GET /health = 200 (used by the unit in ExecStartPost)
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
# shellcheck source=../runtime/common.sh
source "$here/../runtime/common.sh"
REPO="$LOCAL_AGENTIC_REPO"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT_FILE="$UNIT_DIR/$LLM_SERVICE"

die() { echo "error: $*" >&2; exit 2; }
usage() { sed -n '2,28p' "$0"; }

require_key() {
  [ -f "$LLM_API_KEY_FILE" ] || die "key missing: $LLM_API_KEY_FILE (create it with: scripts/llm key)"
}
require_unit() {
  [ -f "$UNIT_FILE" ] || die "unit not installed: $UNIT_FILE (scripts/llm install)"
}

cmd_key() {
  [ $# -eq 0 ] || die "usage: llm key"
  if [ -e "$LLM_API_KEY_FILE" ]; then
    local mode
    mode="$(stat -c %a "$LLM_API_KEY_FILE")"
    case "$mode" in
      600|400) echo "key already exists (mode $mode)" >&2 ;;
      *) echo "warning: key has mode $mode; the server refuses it: chmod 600 $LLM_API_KEY_FILE" >&2 ;;
    esac
    printf '%s\n' "$LLM_API_KEY_FILE"
    return 0
  fi
  local dir tmp
  dir="$(dirname "$LLM_API_KEY_FILE")"
  (umask 077 && mkdir -p "$dir") || die "could not create $dir"
  tmp="$(umask 077 && mktemp "$dir/.llm-api-key.XXXXXX")" || die "could not create a file in $dir"
  if ! python3 -I -c 'import secrets; print("sk-llama-" + secrets.token_hex(32))' > "$tmp"; then
    rm -f "$tmp"; die "could not generate the key"
  fi
  chmod 600 "$tmp"
  # No overwrite: if another run created the key in the meantime, theirs stays.
  mv -n "$tmp" "$LLM_API_KEY_FILE"
  rm -f "$tmp"
  echo "key created (mode 600; content not shown)" >&2
  printf '%s\n' "$LLM_API_KEY_FILE"
}

render_unit() {
  case "$REPO$LLM_API_KEY_FILE" in
    *[[:space:]%\|\\]*) die "path with space, %, | or \\ is not supported in the unit: $REPO / $LLM_API_KEY_FILE" ;;
  esac
  local out
  out="$(sed -e "s|@@REPO@@|$REPO|g" -e "s|@@KEY_FILE@@|$LLM_API_KEY_FILE|g" \
    "$REPO/runtime/llama-server.service.in")" || die "could not read the unit template"
  ! grep -q '@@' <<< "$out" || die "unit template has an unreplaced @@...@@"
  printf '%s\n' "$out"
}

cmd_install() {
  local enable=false dry=false a
  for a in "$@"; do
    case "$a" in
      --enable) enable=true ;;
      --dry-run) dry=true ;;
      *) die "usage: llm install [--enable] [--dry-run]" ;;
    esac
  done
  local rendered
  rendered="$(render_unit)" || exit 2
  if $dry; then
    echo "# --dry-run: nothing written or reloaded. Contents of $UNIT_FILE:"
    printf '%s\n' "$rendered"
    echo "# commands that would run:"
    [ -f "$LLM_API_KEY_FILE" ] || echo "#   scripts/llm key"
    echo "#   mkdir -p $UNIT_DIR && (writes $UNIT_FILE)"
    echo "#   systemctl --user daemon-reload"
    if $enable; then echo "#   systemctl --user enable $LLM_SERVICE"; fi
    local tmpd
    tmpd="$(mktemp -d)"
    printf '%s\n' "$rendered" > "$tmpd/$LLM_SERVICE"
    echo "# systemd-analyze --user verify (temporary copy):"
    if systemd-analyze --user verify "$tmpd/$LLM_SERVICE" 2>&1 | sed 's/^/#   /'; then
      echo "#   (no errors)"
    fi
    rm -rf "$tmpd"
    return 0
  fi
  [ -f "$LLM_API_KEY_FILE" ] || cmd_key > /dev/null
  mkdir -p "$UNIT_DIR" || die "could not create $UNIT_DIR"
  printf '%s\n' "$rendered" > "$UNIT_FILE.tmp" && mv "$UNIT_FILE.tmp" "$UNIT_FILE" \
    || die "could not write $UNIT_FILE"
  systemctl --user daemon-reload || die "daemon-reload failed"
  echo "installed: $UNIT_FILE"
  if $enable; then
    systemctl --user enable "$LLM_SERVICE" || die "enable failed"
    echo "enabled: starts with the user manager (disable: systemctl --user disable $LLM_SERVICE)"
  fi
  echo "next step: scripts/llm start && scripts/llm health"
}

cmd_uninstall() {
  [ $# -eq 0 ] || die "usage: llm uninstall"
  systemctl --user stop "$LLM_SERVICE" 2> /dev/null
  systemctl --user disable "$LLM_SERVICE" 2> /dev/null
  rm -f "$UNIT_FILE"
  systemctl --user daemon-reload
  systemctl --user reset-failed "$LLM_SERVICE" 2> /dev/null
  echo "unit removed ($UNIT_FILE). The key is still in $LLM_API_KEY_FILE."
}

run_preflight() {
  local rc=0
  "$REPO/scripts/preflight.sh" || rc=$?
  [ "$rc" -ne 2 ] || die "preflight blocked the start (fix the BLOCKER above)"
}

cmd_start() {
  [ $# -eq 0 ] || die "usage: llm start"
  require_unit
  local pid
  pid="$(llm_unit_mainpid)"
  if [ "$pid" != 0 ]; then
    echo "already up (PID $pid): $LLM_BASE_URL_LOCAL"
    return 0
  fi
  run_preflight
  systemctl --user reset-failed "$LLM_SERVICE" 2> /dev/null
  echo "starting; the command waits for the model to load (up to 10 min)..."
  local t0=$SECONDS
  if ! systemctl --user start "$LLM_SERVICE"; then
    echo "failed; see: scripts/llm logs" >&2
    return 1
  fi
  echo "up in $((SECONDS - t0)) s: $LLM_BASE_URL_LOCAL (check: scripts/llm health)"
}

cmd_restart() {
  [ $# -eq 0 ] || die "usage: llm restart"
  require_unit
  run_preflight
  systemctl --user reset-failed "$LLM_SERVICE" 2> /dev/null
  echo "restarting; the command waits for the model to load (up to 10 min)..."
  local t0=$SECONDS
  systemctl --user restart "$LLM_SERVICE" || { echo "failed; see: scripts/llm logs" >&2; return 1; }
  echo "up in $((SECONDS - t0)) s: $LLM_BASE_URL_LOCAL"
}

cmd_logs() {
  local follow=() n=200
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) follow=(-f); shift ;;
      -n) n="${2:-}"; shift 2 ;;
      *) die "usage: llm logs [-f] [-n N]" ;;
    esac
  done
  exec journalctl --user -u "$LLM_SERVICE" --no-pager -n "$n" "${follow[@]}"
}

cmd_wait_ready() {
  local timeout=600
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2 ;;
      *) die "usage: llm wait-ready [--timeout S]" ;;
    esac
  done
  local start=$SECONDS last=$SECONDS code
  while :; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$LLM_BASE_URL_LOCAL/health" 2> /dev/null)"
    if [ "$code" = 200 ]; then
      echo "ready in $((SECONDS - start)) s: $LLM_BASE_URL_LOCAL"
      return 0
    fi
    # MAINPID: set by systemd for ExecStartPost.
    if [ -n "${MAINPID:-}" ] && ! kill -0 "$MAINPID" 2> /dev/null; then
      echo "llama-server (PID $MAINPID) exited before becoming ready" >&2
      return 1
    fi
    if [ $((SECONDS - start)) -ge "$timeout" ]; then
      echo "not ready after $timeout s (last HTTP ${code:-000})" >&2
      return 1
    fi
    if [ $((SECONDS - last)) -ge 15 ]; then
      echo "waiting for /health (HTTP ${code:-000}, $((SECONDS - start)) s)"
      last=$SECONDS
    fi
    sleep 1
  done
}

cmd_env() {
  [ $# -eq 0 ] || die "usage: llm env"
  require_key
  local alias
  alias="$(llm_api_alias)"
  printf 'export LLM_BASE_URL=%q\n' "$LLM_BASE_URL_LOCAL"
  printf 'export LLM_MODEL=%q\n' "$alias"
  # The key is read at eval time; this command's output does not contain it.
  printf 'export LLM_API_KEY="$(cat %q)"\n' "$LLM_API_KEY_FILE"
  # Name the 5 agents (agents/lib/common.sh) read today.
  printf 'export LOCAL_LLM_API_KEY="$LLM_API_KEY"\n'
}

cmd_model() {
  local tsv="$REPO/models.tsv"
  case "${1:-}" in
    "")
      local current; current="$(llm_model_alias)"
      echo "selected model: $current (API name: $(llm_api_alias))"
      [ -n "${LLM_SERVER_MODEL:-}" ] && echo "  (comes from LLM_SERVER_MODEL; does not apply to the systemd service)"
      awk -F'\t' '!/^#/ && NF >= 7 {print $1 "\t" $4 "\t" $5 "\t" $7}' "$tsv" |
        while IFS=$'\t' read -r a file bytes role; do
          local mark="-" inst="not downloaded"
          [ "$a" = "$current" ] && mark="*"
          [ -f "$MODELS_DIR/$file" ] && inst="installed"
          printf '  %s %-16s %6.1f GB  %-13s %s\n' "$mark" "$a" "$(awk -v b="$bytes" 'BEGIN{print b/1e9}')" "$inst" "$role"
        done
      ;;
    --reset)
      [ $# -eq 1 ] || die "usage: llm model [<alias>|--reset]"
      rm -f "$LLM_MODEL_CHOICE_FILE"
      echo "choice cleared: back to $(llm_model_alias); takes effect on the next scripts/llm restart"
      ;;
    -*) die "usage: llm model [<alias>|--reset]" ;;
    *)
      [ $# -eq 1 ] || die "usage: llm model [<alias>|--reset]"
      local file
      file="$(awk -F'\t' -v a="$1" '!/^#/ && $1 == a {print $4; exit}' "$tsv")"
      [ -n "$file" ] || die "alias '$1' is not in models.tsv"
      [ -f "$MODELS_DIR/$file" ] || echo "warning: $MODELS_DIR/$file does not exist yet (scripts/fetch-model.sh $1)" >&2
      (umask 077 && mkdir -p "$(dirname "$LLM_MODEL_CHOICE_FILE")") || die "could not create $(dirname "$LLM_MODEL_CHOICE_FILE")"
      printf '%s\n' "$1" > "$LLM_MODEL_CHOICE_FILE"
      echo "selected model: $1 ($file); takes effect on the next scripts/llm start/restart"
      ;;
  esac
}

cmd_test() {
  require_key
  local ts out rc=0
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$REPO/logs"
  out="$REPO/logs/tool_calls-$ts.json"
  python3 -I "$REPO/scripts/tool_calls.py" --base "$LLM_BASE_URL_LOCAL" --model "$(llm_api_alias)" \
    --api-key-file "$LLM_API_KEY_FILE" --json-out "$out" "$@" || rc=$?
  echo "result: $out (exit code $rc)"
  return "$rc"
}

cmd_health() {
  [ $# -eq 0 ] || die "usage: llm health"
  require_key
  local expected="{}"
  if llm_resolve_model; then
    expected="$(env LLAMA_SERVER_HOST="$LLAMA_SERVER_HOST" LLAMA_SERVER_PORT="$LLAMA_SERVER_PORT" \
      LLM_API_KEY_FILE="$LLM_API_KEY_FILE" LOCAL_AGENTIC_REPO="$REPO" \
      python3 -I "$LLAMA_SERVER_ARGS_PY" --bin "$LLAMA_SERVER_BIN" --profile "$LLAMA_SERVER_PROFILE" \
      --policy "$LLAMA_SERVER_POLICY" --model "$MODEL_PATH" --format json 2> /dev/null)" || expected="{}"
  fi
  # Log of the unit's current run: --fit only warns ("failed to fit params") when
  # there is not enough VRAM for the profile's headroom, and loads anyway (runtime/llama-server.args).
  local inv fit_warn=""
  inv="$(systemctl --user show -p InvocationID --value "$LLM_SERVICE" 2> /dev/null)"
  if [ -n "$inv" ] && [ "$(llm_unit_mainpid)" != 0 ]; then
    fit_warn="$(journalctl --user _SYSTEMD_INVOCATION_ID="$inv" --no-pager -o cat 2> /dev/null \
      | grep -c 'failed to fit params')"
  fi
  LLM_HEALTH_FIT_WARN="$fit_warn" LLM_HEALTH_EXPECTED="$expected" \
    python3 -I - "$LLM_BASE_URL_LOCAL" "$LLM_API_KEY_FILE" \
    "$(llm_api_alias)" "$LLAMA_SERVER_PORT" <<'PY'
import json, os, subprocess, sys, time, urllib.error, urllib.request

base, key_file, alias, port = sys.argv[1:5]
expected = json.loads(os.environ.get("LLM_HEALTH_EXPECTED") or "{}")
with open(key_file, encoding="utf-8") as f:
    key = next((l for l in f.read().splitlines() if l and not l.startswith("#")), "")
results = []


def rec(ok, name, detail, ms=None):
    results.append((ok, name, detail, ms))


def req(method, path, body=None, auth=True, headers=None, timeout=15):
    h = {"Content-Type": "application/json"} if body is not None else {}
    if auth:
        h["Authorization"] = "Bearer " + key
    h.update(headers or {})
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(base + path, data=data, method=method, headers=h)
    t0 = time.perf_counter()
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            raw, status, hdrs = resp.read(), resp.status, resp.headers
    except urllib.error.HTTPError as e:
        raw, status, hdrs = e.read(), e.code, e.headers
    except (urllib.error.URLError, OSError) as e:  # refused, timed out
        raw, status, hdrs = str(getattr(e, "reason", e)).encode(), 0, {}
    ms = (time.perf_counter() - t0) * 1000
    try:
        js = json.loads(raw) if raw else None
    except ValueError:
        js = None
    return status, js, raw, hdrs, ms


def exp(name):
    e = expected.get(name)
    return None if e is None else e["value"]


st, js, raw, _, ms = req("GET", "/health", auth=False)
if st == 0:
    print(f"server down at {base}: {raw.decode()} (scripts/llm status / scripts/llm logs)")
    sys.exit(1)
if st == 503:
    print(f"server at {base} is still loading the model (HTTP 503); retry in a few seconds")
    sys.exit(1)

# 1. Availability and latency.
rec(st == 200 and (js or {}).get("status") == "ok", "GET /health (no key)", f"HTTP {st}", ms)
st, js, _, _, ms = req("GET", "/v1/models")
ids = [m.get("id") for m in (js or {}).get("data", [])] if st == 200 else []
rec(st == 200 and alias in ids, "GET /v1/models (with key)", f"HTTP {st}, models {ids}", ms)
st, js, _raw, _, ms = req("POST", "/v1/chat/completions", {
    "model": alias, "max_tokens": 1,
    "messages": [{"role": "user", "content": "Reply only: ok"}]}, timeout=300)
t = (js or {}).get("timings", {})
detail = f"HTTP {st}" if st else f"no response: {_raw.decode()[:80]}"
if st == 200:
    detail += (f", prompt {t.get('prompt_n', '?')} tok in {t.get('prompt_ms', 0):.0f} ms,"
               f" 1st token in {t.get('predicted_ms', 0):.0f} ms")
rec(st == 200, "POST /v1/chat/completions, 1 token", detail, ms)
st, _, raw, _, ms = req("GET", "/metrics")
rec(st == 200 and b"llamacpp:prompt_tokens_total" in raw, "GET /metrics (with key)", f"HTTP {st}", ms)

# 2. Policy applied.
st, _, _, _, _ = req("GET", "/v1/models", auth=False)
rec(st == 401, "key required (GET /v1/models without key)", f"HTTP {st} (expected 401)")
st, js, _, _, _ = req("GET", "/props")
if st == 200 and js:
    params = js.get("default_generation_settings", {}).get("params", {})
    checks = [("endpoint_props", js.get("endpoint_props"), False),
              ("cors_proxy_enabled", js.get("cors_proxy_enabled"), False),
              ("endpoint_metrics", js.get("endpoint_metrics"), True)]
    for field, flag in (("temperature", "--temp"), ("top_p", "--top-p"), ("top_k", "--top-k"),
                        ("min_p", "--min-p"), ("presence_penalty", "--presence-penalty")):
        if exp(flag) is not None:
            checks.append((field, params.get(field), float(exp(flag))))
    # /props shows n_predict=-1 even with -n: the value only appears in the effective request
    # (verified in E5 with response_fields). That is why -n is checked on a real request.
    if exp("-n") is not None:
        # No max_tokens on purpose (to see the default); the stop words end generation
        # at the first space or line break, so the request is always short.
        st2, js2, _, _, _ = req("POST", "/completion", {
            "prompt": "Reply only: OK", "stop": ["\n", " ", "."],
            "response_fields": ["generation_settings/n_predict"]}, timeout=60)
        got = (js2 or {}).get("generation_settings/n_predict") if st2 == 200 else f"HTTP {st2}"
        if isinstance(js2, dict) and "generation_settings" in js2:
            got = js2["generation_settings"].get("n_predict")
        checks.append(("effective n_predict", got, float(exp("-n"))))
    if exp("-np") is not None:
        checks.append(("total_slots", js.get("total_slots"), int(exp("-np"))))
    if exp("-c") is not None:
        checks.append(("n_ctx", js.get("default_generation_settings", {}).get("n_ctx"), int(exp("-c"))))
    bad = [f"{f}={got!r} (expected {want!r})" for f, got, want in checks
           if not (got == want or (isinstance(got, (int, float)) and not isinstance(got, bool)
                                   and isinstance(want, float) and abs(got - want) < 1e-6))]
    rec(not bad, "GET /props: defaults and routes", "; ".join(bad) or
        ", ".join(f"{f}={got}" for f, got, _ in checks))
else:
    rec(False, "GET /props", f"HTTP {st}")
st, _, _, _, _ = req("POST", "/props", {})
rec(st == 501, "POST /props disabled (no --props)", f"HTTP {st} (expected 501)")
# Invalid action on purpose: without --slot-save-path the route answers 501 before looking at
# the action; with it enabled it would answer 400 ("Invalid action"). Nothing is written in either case.
st, _, _, _, _ = req("POST", "/slots/0?action=llm-health-probe", {})
rec(st == 501, "POST /slots disabled (no --slot-save-path)", f"HTTP {st} (expected 501)")
st, _, _, _, _ = req("GET", "/tools")
rec(st == 403, "GET /tools disabled (no --tools/--agent)", f"HTTP {st} (expected 403)")
st, _, _, _, _ = req("GET", "/cors-proxy")
rec(st == 403, "GET /cors-proxy disabled (no --ui-mcp-proxy)", f"HTTP {st} (expected 403)")
evil = "http://example.invalid"
st, _, _, h, _ = req("OPTIONS", "/v1/chat/completions", auth=False,
                     headers={"Origin": evil, "Access-Control-Request-Method": "POST"})
acao, acac = h.get("Access-Control-Allow-Origin"), h.get("Access-Control-Allow-Credentials")
rec(acao not in (evil, "*") and acac == "false", "CORS for another origin",
    f"Allow-Origin={acao!r}, Allow-Credentials={acac!r}")
fit = os.environ.get("LLM_HEALTH_FIT_WARN", "")
if fit:
    rec(fit == "0", "log: VRAM fit the profile headroom (--fit)",
        "no 'failed to fit params'" if fit == "0" else f"{fit}x 'failed to fit params' (little free VRAM at load)")
try:
    out = subprocess.run(["ss", "-Hltn", f"sport = :{port}"], capture_output=True, text=True,
                         timeout=5).stdout.split()
    addrs = [w for w in out if w.endswith(f":{port}")]
    rec(bool(addrs) and all(a.startswith(("127.", "[::1]", "::1")) for a in addrs),
        "listens on loopback only", ", ".join(addrs) or "no socket")
except (OSError, subprocess.TimeoutExpired) as e:
    rec(False, "listens on loopback only", str(e))

print(f"llama-server health at {base}")
for ok, name, detail, ms in results:
    lat = f"{ms:7.0f} ms" if ms is not None else " " * 10
    print(f"  {'ok   ' if ok else 'FAIL '}  {name:<46} {lat}  {detail}")
fails = sum(1 for r in results if not r[0])
print(f"result: {len(results) - fails} ok, {fails} failure(s)")
sys.exit(1 if fails else 0)
PY
}

cmd="${1:-}"
[ $# -eq 0 ] || shift
case "$cmd" in
  key) cmd_key "$@" ;;
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  start) cmd_start "$@" ;;
  stop) require_unit; systemctl --user stop "$LLM_SERVICE" ;;
  restart) cmd_restart "$@" ;;
  status) require_unit; systemctl --user status "$LLM_SERVICE" --no-pager -n 5 ;;
  logs) cmd_logs "$@" ;;
  health) cmd_health "$@" ;;
  preflight) exec "$REPO/scripts/preflight.sh" "$@" ;;
  dry-run) exec "$REPO/runtime/llama-server-start.sh" --dry-run ;;
  model) cmd_model "$@" ;;
  env) cmd_env "$@" ;;
  test) cmd_test "$@" ;;
  wait-ready) cmd_wait_ready "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
