#!/usr/bin/env bash
# Blocks the commit if any added line matches a pattern in
# .publish-denylist.local (one extended regex per line, case-insensitive).
# The list stays outside git so the sensitive terms themselves are not published.
# Activation: git config core.hooksPath scripts/hooks
set -euo pipefail
list="$(git rev-parse --show-toplevel)/.publish-denylist.local"
[ -f "$list" ] || exit 0

patterns="$(grep -vE '^[[:space:]]*(#|$)' "$list" || true)"
[ -n "$patterns" ] || exit 0

hits="$(git diff --cached -U0 --no-color \
  | grep -E '^(\+\+\+ b/|\+)' \
  | awk '/^\+\+\+ b\//{file=substr($0,7); next} {print file": "substr($0,2)}' \
  | grep -iE -f <(printf '%s\n' "$patterns") || true)"

if [ -n "$hits" ]; then
  echo "pre-commit: content blocked by .publish-denylist.local:" >&2
  printf '%s\n' "$hits" | cut -c1-200 >&2
  exit 1
fi
