{
  "//": "Provedor do llama-server local para o Pi 1.4.x. Gerado em $PI_CODING_AGENT_DIR/models.json por run.sh/pi-local. O provedor embutido 'llama.cpp' do Pi exige o modo router do llama-server; aqui o servidor roda com um modelo só (-m), por isso o provedor é declarado como endpoint compatível.",
  "providers": {
    "local": {
      "name": "llama.cpp local",
      "baseUrl": "@@LLM_BASE_URL@@/v1",
      "api": "openai-completions",
      "apiKey": "$LOCAL_LLM_API_KEY",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsStore": false,
        "supportsReasoningEffort": false,
        "supportsUsageInStreaming": true,
        "supportsStrictMode": false,
        "maxTokensField": "max_tokens",
        "thinkingFormat": "qwen-chat-template"
      },
      "models": [
        {
          "id": "@@LLM_MODEL@@",
          "name": "Qwen3.6-35B-A3B (local)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": "@@INT:LLM_CONTEXT@@",
          "maxTokens": "@@INT:LLM_MAX_OUTPUT@@",
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          "samplingParams": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0,
            "presence_penalty": 0
          }
        }
      ]
    }
  }
}
