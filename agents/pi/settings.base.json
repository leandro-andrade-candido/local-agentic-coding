{
  "//": "Base for Pi 1.4.x. Generated in $PI_CODING_AGENT_DIR/settings.json, merged with settings.<profile>.json.",
  "defaultProvider": "local",
  "defaultModel": "@@LLM_MODEL@@",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["read", "bash", "edit", "write"],
  "cacheWarming": "off",
  "compaction": {
    "//": "Compacts when fewer than 32k tokens remain free: ~98k of 131k.",
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "httpIdleTimeoutMs": 900000,
  "retry": { "enabled": true, "maxRetries": 2 },
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "quietStartup": true,
  "extensions": ["-builtin:mcp", "-builtin:llama.cpp"]
}
