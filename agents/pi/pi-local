#!/usr/bin/env bash
# Interactive Pi pointed at the local llama-server, with isolated config.
# Usage: cd <project> && <repo>/agents/pi/pi-local [pi options]
# Profile: AGENT_PROFILE=interactive (default) or autonomous.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive pi
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin pi pi)" --provider local --model "$LLM_MODEL" "${PI_EXT_ARGS[@]}" "$@"
