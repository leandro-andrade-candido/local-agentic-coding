#!/usr/bin/env bash
# Pi interativo apontado para o llama-server local, com config isolada.
# Uso: cd <projeto> && <repo>/agents/pi/pi-local [opções do pi]
# Perfil: AGENT_PROFILE=interactive (padrão) ou autonomous.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive pi
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin pi pi)" --provider local --model "$LLM_MODEL" "${PI_EXT_ARGS[@]}" "$@"
