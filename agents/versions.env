# Versões fixadas dos agentes (harnesses). Fonte única para agents/install.sh e
# agents/lib/common.sh. Consultado no npm em 29/10/2026; ver agents/README.md.
# Proposta: mesclar este bloco ao versions.env da raiz quando a E6 for aprovada.

# Cada agente vai para $AGENTS_PREFIX/<agente>/<versão>, com link "current"
# (mesmo padrão do llama.cpp). Nada é instalado no prefixo global do npm.
AGENTS_PREFIX="${AGENTS_PREFIX:-$HOME/.local/opt/agents}"
# Estado das sessões interativas (config gerada, histórico). As execuções do
# eval usam um diretório novo dentro de --log-dir a cada vez.
AGENTS_STATE="${AGENTS_STATE:-$HOME/.local/state/local-agentic/agents}"

# Qwen Code: npm "latest" em 29/10 (publicado em 28/10/2026). Apache-2.0.
QWEN_CODE_PKG="@qwen-code/qwen-code"
QWEN_CODE_VERSION="0.26.3"
QWEN_CODE_INTEGRITY="sha512-z8dL1+N2eI1RwQm/tceJmFbxPtdin4TKpFucoau8Nl4bm/DsXsohQLFPM45t20sVzAaYg8aH8qLpX5RCIiXE3A=="

# Pi (earendil-works/pi, antigo @mariozechner/pi-coding-agent): "latest" (21/10/2026). MIT.
PI_PKG="@earendil-works/pi-coding-agent"
PI_VERSION="1.4.0"
PI_INTEGRITY="sha512-Z41LpZ3yYHSC/UUps6Mr39UMFPwH8elhJBG9DY1P7kuzsE5qSK/6eMj2EHzO5evJRQWLbKSqUMw+4nCNtIyiQg=="

# OpenCode 1.x: "latest" do pacote opencode-ai (28/10/2026). MIT.
# A linha 2.x (2.2.1) é outro pacote, @opencode/cli; ver opencode/README.md.
OPENCODE_PKG="opencode-ai"
OPENCODE_VERSION="1.19.5"
OPENCODE_INTEGRITY="sha512-tEqMvQahfhdDj8vceYpXtoIrvjPXm5XRfetWnPN5YISueU7adNx9JcUA3zZ+2GKuDVgDpGdQe1ZLtCZDjqodvA=="

# Claude Code: canal "stable" do npm (22/10/2026). "latest" é 2.1.312. Licença proprietária.
CLAUDE_CODE_PKG="@anthropic-ai/claude-code"
CLAUDE_CODE_VERSION="2.1.308"
CLAUDE_CODE_INTEGRITY="sha512-b2HnszgyN73wRTFP+IYPDJNn9ADXnG6jr26ibL+w03HSKqfb6GqE8Jnfr4mz37Zv4AT/NP+B5/3c1F89WTdWSA=="

# Codex CLI: "latest" do @openai/codex (27/10/2026), igual ao Codex do dia a dia. Apache-2.0.
# O pacote é um lançador de 13 KB; o binário nativo vem em dependência opcional por plataforma.
CODEX_PKG="@openai/codex"
CODEX_VERSION="0.165.0"
CODEX_INTEGRITY="sha512-aiwtQVp2KBhJld966CuU5bVfQ46VNB4mNTl6giX3WGZdt4euI3tv2RUqJpnupPNA8DXHg2z+RoQ0Zfw87dy8Lw=="

# Servidor e modelo (podem ser sobrepostos por LLM_BASE_URL / LLM_MODEL no ambiente).
LLM_BASE_URL_DEFAULT="http://127.0.0.1:9931"
LLM_MODEL_DEFAULT="qwen3.6-35b"
# Janela do llama-server (-c) e saída máxima por resposta (cartão do modelo: 32768).
LLM_CONTEXT_DEFAULT=131072
LLM_MAX_OUTPUT_DEFAULT=32768
