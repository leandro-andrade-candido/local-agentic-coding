# Pinned agent (harness) versions. Single source for agents/install.sh and
# agents/lib/common.sh. Looked up on npm on 2026-10-29; see agents/README.md.
# Proposal: merge this block into the root versions.env when E6 is approved.

# Each agent goes to $AGENTS_PREFIX/<agent>/<version>, with a "current" link
# (same pattern as llama.cpp). Nothing is installed in npm's global prefix.
AGENTS_PREFIX="${AGENTS_PREFIX:-$HOME/.local/opt/agents}"
# State of interactive sessions (generated config, history). Eval runs
# use a new directory inside --log-dir each time.
AGENTS_STATE="${AGENTS_STATE:-$HOME/.local/state/local-agentic/agents}"

# Qwen Code: npm "latest" on Oct 29 (published 2026-10-28). Apache-2.0.
QWEN_CODE_PKG="@qwen-code/qwen-code"
QWEN_CODE_VERSION="0.26.3"
QWEN_CODE_INTEGRITY="sha512-z8dL1+N2eI1RwQm/tceJmFbxPtdin4TKpFucoau8Nl4bm/DsXsohQLFPM45t20sVzAaYg8aH8qLpX5RCIiXE3A=="

# Pi (earendil-works/pi, formerly @mariozechner/pi-coding-agent): "latest" (2026-10-21). MIT.
PI_PKG="@earendil-works/pi-coding-agent"
PI_VERSION="1.4.0"
PI_INTEGRITY="sha512-Z41LpZ3yYHSC/UUps6Mr39UMFPwH8elhJBG9DY1P7kuzsE5qSK/6eMj2EHzO5evJRQWLbKSqUMw+4nCNtIyiQg=="

# OpenCode 1.x: "latest" of the opencode-ai package (2026-10-28). MIT.
# The 2.x line (2.2.1) is another package, @opencode/cli; see opencode/README.md.
OPENCODE_PKG="opencode-ai"
OPENCODE_VERSION="1.19.5"
OPENCODE_INTEGRITY="sha512-tEqMvQahfhdDj8vceYpXtoIrvjPXm5XRfetWnPN5YISueU7adNx9JcUA3zZ+2GKuDVgDpGdQe1ZLtCZDjqodvA=="

# Claude Code: npm "stable" channel (2026-10-22). "latest" is 2.1.312. Proprietary license.
CLAUDE_CODE_PKG="@anthropic-ai/claude-code"
CLAUDE_CODE_VERSION="2.1.308"
CLAUDE_CODE_INTEGRITY="sha512-b2HnszgyN73wRTFP+IYPDJNn9ADXnG6jr26ibL+w03HSKqfb6GqE8Jnfr4mz37Zv4AT/NP+B5/3c1F89WTdWSA=="

# Codex CLI: "latest" of @openai/codex (2026-10-27), same as the everyday Codex. Apache-2.0.
# The package is a 13 KB launcher; the native binary comes as a per-platform optional dependency.
CODEX_PKG="@openai/codex"
CODEX_VERSION="0.165.0"
CODEX_INTEGRITY="sha512-aiwtQVp2KBhJld966CuU5bVfQ46VNB4mNTl6giX3WGZdt4euI3tv2RUqJpnupPNA8DXHg2z+RoQ0Zfw87dy8Lw=="

# Server and model (can be overridden by LLM_BASE_URL / LLM_MODEL in the environment).
LLM_BASE_URL_DEFAULT="http://127.0.0.1:9931"
LLM_MODEL_DEFAULT="qwen3.6-35b"
# llama-server window (-c) and maximum output per response (model card: 32768).
LLM_CONTEXT_DEFAULT=131072
LLM_MAX_OUTPUT_DEFAULT=32768
