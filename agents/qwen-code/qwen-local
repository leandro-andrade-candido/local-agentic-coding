#!/usr/bin/env bash
# Qwen Code interativo apontado para o llama-server local, com config isolada.
# Uso: cd <projeto> && <repo>/agents/qwen-code/qwen-local [opções do qwen]
# Perfil: AGENT_PROFILE=interactive (padrão) ou autonomous.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive qwen-code
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin qwen-code qwen)" "$@"
