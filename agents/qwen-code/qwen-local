#!/usr/bin/env bash
# Interactive Qwen Code pointed at the local llama-server, with isolated config.
# Usage: cd <project> && <repo>/agents/qwen-code/qwen-local [qwen options]
# Profile: AGENT_PROFILE=interactive (default) or autonomous.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive qwen-code
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin qwen-code qwen)" "$@"
