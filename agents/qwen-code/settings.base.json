{
  "//": "Base for Qwen Code 0.26.x against the local llama-server. Generated in $QWEN_HOME/settings.json by run.sh/qwen-local (agents/lib/render.py), merged with settings.<profile>.json. '//' keys are removed.",
  "$version": 4,
  "general": {
    "enableAutoUpdate": false,
    "showSessionRecap": false,
    "gitCoAuthor": { "commit": false, "pr": false }
  },
  "privacy": { "usageStatisticsEnabled": false },
  "telemetry": { "enabled": false, "logPrompts": false },
  "ui": {
    "//": "Follow-up suggestions and feedback call the model in the background: with a single slot, each extra call wipes the prompt cache.",
    "enableFollowupSuggestions": false,
    "enableUserFeedback": false,
    "enableWelcomeBack": false,
    "showResponseTokensPerSecond": true
  },
  "security": { "auth": { "selectedType": "openai" } },
  "model": {
    "name": "@@LLM_MODEL@@",
    "skipNextSpeakerCheck": true
  },
  "modelProviders": {
    "openai": [
      {
        "id": "@@LLM_MODEL@@",
        "name": "Qwen3.6-35B-A3B (llama.cpp local)",
        "envKey": "LOCAL_LLM_API_KEY",
        "baseUrl": "@@LLM_BASE_URL@@/v1",
        "generationConfig": {
          "//": "timeout 0 = no per-request limit; the ~100k-token prefill takes minutes.",
          "timeout": 0,
          "streamIdleTimeoutMs": 900000,
          "maxRetries": 2,
          "contextWindowSize": "@@INT:LLM_CONTEXT@@",
          "modalities": { "image": false, "pdf": false, "audio": false, "video": false },
          "samplingParams": {
            "//": "Model card, thinking mode for precise code. With samplingParams Qwen Code sends the keys as they are and does not compute max_tokens itself.",
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0,
            "presence_penalty": 0,
            "max_tokens": "@@INT:LLM_MAX_OUTPUT@@"
          },
          "extra_body": {
            "chat_template_kwargs": { "preserve_thinking": true }
          }
        }
      }
    ]
  },
  "context": {
    "//": "Compacts at ~75% of the window (98k of 131k), leaving ~32k for the response.",
    "autoCompactThreshold": 0.75
  },
  "tools": {
    "shell": { "defaultTimeoutMs": 300000 },
    "disabled": [
      "web_search",
      "image_gen",
      "artifact",
      "record_artifact",
      "cron_create",
      "cron_list",
      "cron_delete",
      "autofix_pr"
    ]
  },
  "memory": {
    "//": "Automatic memory off: the catalog goes at the end of each request and forces reprocessing the whole prompt on hybrid models in llama.cpp (QwenLM/qwen-code#14203).",
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false,
    "enableAutoSkill": false
  },
  "agents": { "crossSessionMessaging": false },
  "experimental": {
    "cron": false,
    "artifact": false,
    "emitToolUseSummaries": false
  },
  "goals": { "modelProposed": "disabled" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "name": "local-guard",
            "command": "python3 -I \"@@AGENT_GUARD@@\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
