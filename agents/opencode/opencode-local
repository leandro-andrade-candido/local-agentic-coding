#!/usr/bin/env bash
# Interactive OpenCode 1.x pointed at the local llama-server, with isolated config.
# Usage: cd <project> && <repo>/agents/opencode/opencode-local [opencode options]
# Profile: AGENT_PROFILE=interactive (default) or autonomous.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive opencode
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin opencode opencode)" "$@"
