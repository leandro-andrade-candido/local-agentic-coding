{
  "//": "Base for OpenCode 1.19.x. Generated in $XDG_CONFIG_HOME/opencode/opencode.json (isolated directory) by run.sh/opencode-local, merged with opencode.<profile>.json.",
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "llamacpp"
  ],
  "model": "llamacpp/@@LLM_MODEL@@",
  "small_model": "llamacpp/@@LLM_MODEL@@",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp local",
      "options": {
        "baseURL": "@@LLM_BASE_URL@@/v1",
        "apiKey": "{env:LOCAL_LLM_API_KEY}",
        "timeout": false,
        "headerTimeout": 1800000,
        "chunkTimeout": 900000
      },
      "models": {
        "@@LLM_MODEL@@": {
          "name": "Qwen3.6-35B-A3B (local)",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "//interleaved": "Sends the previous reasoning back in reasoning_content (Qwen3.6 preserve_thinking).",
          "interleaved": {
            "field": "reasoning_content"
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "//limit": "OpenCode caps the output at 32000 and compacts at context - output = ~99k.",
          "limit": {
            "context": "@@INT:LLM_CONTEXT@@",
            "output": "@@INT:LLM_MAX_OUTPUT@@"
          },
          "//options": "Extra fields go straight into the request body (@ai-sdk/openai-compatible).",
          "options": {
            "top_k": 20,
            "min_p": 0,
            "presence_penalty": 0,
            "chat_template_kwargs": {
              "preserve_thinking": true
            }
          }
        }
      }
    }
  },
  "agent": {
    "//": "temperature and top_p are per agent in OpenCode. The title agent is off: with a single slot, each extra call wipes the prompt cache.",
    "build": {
      "temperature": 0.6,
      "top_p": 0.95
    },
    "plan": {
      "temperature": 0.6,
      "top_p": 0.95
    },
    "general": {
      "temperature": 0.6,
      "top_p": 0.95
    },
    "explore": {
      "temperature": 0.6,
      "top_p": 0.95
    },
    "compaction": {
      "temperature": 0.6,
      "top_p": 0.95
    },
    "title": {
      "disable": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": false
  }
}
