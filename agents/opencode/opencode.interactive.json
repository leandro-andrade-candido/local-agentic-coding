{
  "//": "Perfil interativo. No OpenCode vale a última regra que casa, por isso o '*' vem primeiro. Comandos de shell são casados depois de separados (a | b vira 'a' e 'b'); 'sh', 'bash' sem argumentos pegam o curl | sh. O plugin plugins/guard.js aplica lib/guard.py a todo comando.",
  "permission": {
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "allow",
    "bash": {
      "*": "ask",
      "git push": "deny",
      "git push *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "doas *": "deny",
      "sh": "deny",
      "bash": "deny",
      "zsh": "deny",
      "dash": "deny"
    },
    "webfetch": "ask",
    "websearch": "deny",
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
