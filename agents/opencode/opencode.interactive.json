{
  "//": "Interactive profile. In OpenCode the last matching rule wins, so '*' comes first. Shell commands are matched after being split (a | b becomes 'a' and 'b'); 'sh' and 'bash' without arguments catch curl | sh. The plugins/guard.js plugin applies lib/guard.py to every command.",
  "permission": {
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "allow",
    "bash": {
      "*": "ask",
      "git push": "deny",
      "git push *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "doas *": "deny",
      "sh": "deny",
      "bash": "deny",
      "zsh": "deny",
      "dash": "deny"
    },
    "webfetch": "ask",
    "websearch": "deny",
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
