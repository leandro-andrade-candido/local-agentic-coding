{
  "//": "Eval profile (run.sh uses 'opencode run --auto': what would be 'ask' is approved, 'deny' still blocks). Outside the project only /tmp; doom_loop (3 identical calls) is denied to cut loops.",
  "permission": {
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "deny",
    "bash": {
      "*": "allow",
      "git push": "deny",
      "git push *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "doas *": "deny",
      "sh": "deny",
      "bash": "deny",
      "zsh": "deny",
      "dash": "deny",
      "npm install": "deny",
      "npm install *": "deny",
      "npm i *": "deny",
      "npm ci": "deny",
      "npm ci *": "deny",
      "npm add *": "deny",
      "pnpm install": "deny",
      "pnpm install *": "deny",
      "pnpm add *": "deny",
      "yarn add *": "deny",
      "yarn install": "deny",
      "bun add *": "deny",
      "bun install": "deny",
      "pip install *": "deny",
      "pip3 install *": "deny",
      "python -m pip install *": "deny",
      "python3 -m pip install *": "deny",
      "uv add *": "deny",
      "uv pip install *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "brew *": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": { "*": "deny", "/tmp/*": "allow" },
    "doom_loop": "deny"
  }
}
