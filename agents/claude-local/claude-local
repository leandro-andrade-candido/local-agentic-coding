#!/usr/bin/env bash
# Claude Code interativo com o modelo local, com config isolada (CLAUDE_CONFIG_DIR).
# Não toca no Claude Code do dia a dia (~/.claude, ~/.claude.json, login da conta).
# Uso: cd <projeto> && <repo>/agents/claude-local/claude-local [opções do claude]
# Perfil: AGENT_PROFILE=interactive (padrão) ou autonomous.
# Por padrão usa o binário fixado em $AGENTS_PREFIX; para usar o já instalado:
#   AGENT_BIN="$(command -v claude)" claude-local
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive claude-local
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin claude-local claude)" --model "$LLM_MODEL" --tools "$CLAUDE_LOCAL_TOOLS" "$@"
