#!/usr/bin/env bash
# Interactive Claude Code with the local model, with isolated config (CLAUDE_CONFIG_DIR).
# Does not touch the everyday Claude Code (~/.claude, ~/.claude.json, account login).
# Usage: cd <project> && <repo>/agents/claude-local/claude-local [claude options]
# Profile: AGENT_PROFILE=interactive (default) or autonomous.
# By default it uses the binary pinned in $AGENTS_PREFIX; to use the installed one:
#   AGENT_BIN="$(command -v claude)" claude-local
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive claude-local
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin claude-local claude)" --model "$LLM_MODEL" --tools "$CLAUDE_LOCAL_TOOLS" "$@"
