# Execution rules (execpolicy, Starlark) of the local Codex, in both profiles.
# Copied to $CODEX_HOME/rules/local.rules. "forbidden" blocks without asking;
# the most restrictive decision among the matching rules wins. They match by argv
# prefix; simple "bash -lc" scripts are split into commands. Forms such as
# `git -C x push` are left to the agents/lib/guard.py hook.

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "git push is not allowed: pushing is always done manually by the user.",
    match = ["git push", "git push origin main"],
    not_match = ["git pull", "git status"],
)

prefix_rule(
    pattern = [["sudo", "su", "doas", "pkexec", "runuser"]],
    decision = "forbidden",
    justification = "Privilege escalation is not allowed.",
    match = ["sudo apt install x", "su -"],
)
