#!/usr/bin/env bash
# Interactive Codex CLI with the local model, with isolated config (CODEX_HOME).
# Does not touch the everyday Codex (~/.codex, ChatGPT login).
# Usage: cd <project> && <repo>/agents/codex-local/codex-local [codex options]
# Profile: AGENT_PROFILE=interactive (default: on-request approval + sandbox
# workspace-write) or autonomous.
# By default it uses the binary pinned in $AGENTS_PREFIX; to use the installed one:
#   AGENT_BIN="$(command -v codex)" codex-local
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive codex-local
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin codex-local codex)" "${CODEX_COMMON_ARGS[@]}" "$@"
