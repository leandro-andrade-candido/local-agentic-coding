#!/usr/bin/env bash
# Codex CLI interativo com o modelo local, com config isolada (CODEX_HOME).
# Não toca no Codex do dia a dia (~/.codex, login ChatGPT).
# Uso: cd <projeto> && <repo>/agents/codex-local/codex-local [opções do codex]
# Perfil: AGENT_PROFILE=interactive (padrão: aprovação on-request + sandbox
# workspace-write) ou autonomous.
# Por padrão usa o binário fixado em $AGENTS_PREFIX; para usar o já instalado:
#   AGENT_BIN="$(command -v codex)" codex-local
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$HERE/../lib/common.sh"
setup_interactive codex-local
source "$HERE/env.sh"
exec_agent_interactive "$(agent_bin codex-local codex)" "${CODEX_COMMON_ARGS[@]}" "$@"
