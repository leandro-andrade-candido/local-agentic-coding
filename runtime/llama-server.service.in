# llama-server systemd --user unit (E5). Template: `scripts/llm install` replaces the
# repository and key-file placeholders and writes it to
# ~/.config/systemd/user/llama-server.service.
# No root and no system unit. Undo: `scripts/llm uninstall`.
#
# What comes from where:
#   - build, port, directories: versions.env, read by the wrapper on every start
#     (changed versions.env or the profile? just `scripts/llm restart`);
#   - arguments: runtime/llama-server.args (E4) + runtime/llama-server.policy.args (E5);
#   - environment: runtime/llama-server.env, loaded by the wrapper (not by
#     EnvironmentFile=, so it applies the same on a manual start);
#   - key: only the file path; the content never appears in the unit.
# Running `scripts/llm install` again is only needed if the repository moves or if
# this template changes.

[Unit]
Description=Local llama-server (model for the coding agents, 127.0.0.1 only)
Documentation=file://@@REPO@@/docs/stages/E5-preparation.md
# Up to 5 starts in 30 min; then it stays "failed" until `scripts/llm start`
# (which runs reset-failed). Avoids a loop when the GPU or the model has a problem.
StartLimitIntervalSec=30min
StartLimitBurst=5

[Service]
# exec: the wrapper execs llama-server, which becomes the main process (MainPID).
# Stopping = signal to that PID; no pkill by name pattern (an E3 problem).
Type=exec
Environment=LLM_API_KEY_FILE=@@KEY_FILE@@
ExecStart=@@REPO@@/runtime/llama-server-start.sh
# Ready only when GET /health answers 200 (model loaded): `systemctl --user start`
# waits here. Gives up after 10 min or if the main process dies.
ExecStartPost=@@REPO@@/scripts/llm wait-ready --timeout 600
# Loading the 22 GB model: ~30 s with -lm dio and a cold disk cache in E4; mmap took
# ~2.5 min. 11 min covers the worst case and the wait above.
TimeoutStartSec=11min

# Automatic restart only on failure (exit != 0, signal, failure of the wait above), with
# growing delay: 10 s, ... up to 5 min in 5 steps.
Restart=on-failure
# Exit code 2 = wrapper refusal (arguments, model, key, preflight blocked): restarting
# does not help; it stays "failed" with the reason in the log.
RestartPreventExitStatus=2
RestartSec=10s
RestartSteps=5
RestartMaxDelaySec=5min

# Clean stop: SIGTERM only to llama-server (it finishes the request in progress and frees the
# pinned memory); if it does not exit within 90 s, SIGKILL to the whole group.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90s
SendSIGKILL=yes

# Logs in journald: `scripts/llm logs [-f]` or journalctl --user -u llama-server.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server

# Hardening that works in a user unit without namespaces. ProtectSystem=,
# PrivateTmp= and the like need user namespaces and were not tested with WSL's /dev/dxg.
NoNewPrivileges=yes
UMask=0077
WorkingDirectory=%h

[Install]
# Only with `scripts/llm install --enable`: starts together with the user manager
# (first WSL shell). Takes all the VRAM and ~20 GB of pinned RAM.
WantedBy=default.target
