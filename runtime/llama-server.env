# Ambiente do llama-server (E4). Formato compatível com EnvironmentFile= do systemd.
# Lotes com menos de 1024 tokens calculam os experts na CPU em vez de copiá-los pela PCIe:
# turnos curtos de agente ficam ~2,2x mais rápidos (pp128: 400 contra 181 tok/s na verificação independente; 384 contra 142 no benchmark).
GGML_OP_OFFLOAD_MIN_BATCH=1024
