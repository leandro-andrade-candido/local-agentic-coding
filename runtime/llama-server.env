# llama-server environment (E4). Format compatible with systemd's EnvironmentFile=.
# Batches under 1024 tokens compute the experts on the CPU instead of copying them over PCIe:
# short agent turns get ~2.2x faster (pp128: 400 vs 181 tok/s in the independent verification; 384 vs 142 in the benchmark).
GGML_OP_OFFLOAD_MIN_BATCH=1024
