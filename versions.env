# Version manifest of the local agentic environment.
# Single source for the scripts in scripts/. Changing it here = updating the environment.

# Inference runtime (llama.cpp, prebuilt binary; the CUDA 12.8 build
# has native code for Blackwell sm_120 and runs with the current driver, CUDA 13.3).
LLAMA_CPP_BUILD=b11982
LLAMA_CPP_VARIANT=ubuntu-cuda-12.8-x64
LLAMA_CPP_SHA256_MAIN=c1d210f1060afe186148b19a32c079aefc19c715cece56125df6354ab759810d
LLAMA_CPP_SHA256_CUDART=ca24c61ecf5ad7c0984850114130760e0aaa87accca14b41c242e25b59b18e84
LLAMA_CPP_PREFIX="$HOME/.local/opt/llama.cpp"

# Server. Port 8080 is already used by another local service; 9931 is the llama.cpp v0.7.0 default.
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=9931

# Models (full list with hashes in models.tsv).
MODELS_DIR="$HOME/models"
CACHE_DIR="$HOME/.cache/local-agentic"

# Skills (SKILL.md standard). Base: Superpowers, pinned to the same version the author uses in
# Claude Code. v7.0.1 (Oct 21) shortens long skills and redoes brainstorming; a candidate to
# test if the 6.4.1 skills weigh on the local model. Profiles in skills/profiles/.
SUPERPOWERS_REPO=obra/superpowers
SUPERPOWERS_VERSION=v6.4.1
SUPERPOWERS_COMMIT=5bf4e78011075bcfc0dc295f0724994cd123ee71
# Anthropic skills (Apache-2.0 per skill; the repo has no tags, so the commit is pinned).
# They enter the profiles as `anthropic:<name>`; only the folders used are downloaded.
ANTHROPIC_SKILLS_REPO=anthropics/skills
ANTHROPIC_SKILLS_COMMIT=ca45fc496a3436251f191354091d557da31c15b5
SKILLS_PREFIX="$HOME/.local/opt/skills"
