# Manifesto de versões do ambiente agentic local.
# Fonte única para os scripts em scripts/. Alterar aqui = atualizar o ambiente.

# Runtime de inferência (llama.cpp, binário pré-compilado; o build CUDA 12.8
# tem código nativo para Blackwell sm_120 e roda com o driver atual, CUDA 13.3).
LLAMA_CPP_BUILD=b11982
LLAMA_CPP_VARIANT=ubuntu-cuda-12.8-x64
LLAMA_CPP_SHA256_MAIN=c1d210f1060afe186148b19a32c079aefc19c715cece56125df6354ab759810d
LLAMA_CPP_SHA256_CUDART=ca24c61ecf5ad7c0984850114130760e0aaa87accca14b41c242e25b59b18e84
LLAMA_CPP_PREFIX="$HOME/.local/opt/llama.cpp"

# Servidor. A porta 8080 já é usada por outro serviço local; 9931 é o padrão do llama.cpp v0.7.0.
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=9931

# Modelos (lista completa com hashes em models.tsv).
MODELS_DIR="$HOME/models"
CACHE_DIR="$HOME/.cache/local-agentic"

# Skills (padrão SKILL.md). Base: Superpowers, fixado na mesma versão que o autor usa no
# Claude Code. A v7.0.1 (21/10) encurta skills longas e refaz o brainstorming; candidata a
# teste se as skills da 6.4.1 pesarem no modelo local. Perfis em skills/profiles/.
SUPERPOWERS_REPO=obra/superpowers
SUPERPOWERS_VERSION=v6.4.1
SUPERPOWERS_COMMIT=5bf4e78011075bcfc0dc295f0724994cd123ee71
SKILLS_PREFIX="$HOME/.local/opt/skills"
