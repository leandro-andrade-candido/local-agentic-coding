+
 export const WEEKDAY_DICTIONARY: { [word: string]: number } = {
     "domingo": 0,
     "dom": 0,
@@ -84,3 +88,85 @@ export function parseYear(match: string): number {
 
     return parseInt(match);
 }
+
+//-----------------------------
+// Expressões relativas com unidades de tempo ("há 3 dias", "daqui a 2 semanas")
+
+export const INTEGER_WORD_DICTIONARY: { [word: string]: number } = {
+    "um": 1,
+    "uma": 1,
+    "dois": 2,
+    "duas": 2,
+    "três": 3,
+    "tres": 3,
+    "quatro": 4,
+    "cinco": 5,
+    "seis": 6,
+    "sete": 7,
+    "oito": 8,
+    "nove": 9,
+    "dez": 10,
+    "onze": 11,
+    "doze": 12,
+};
+
+// "h" e "seg" ficam de fora: "15h" é horário e "seg" é segunda-feira.
+export const TIME_UNIT_DICTIONARY: { [word: string]: Timeunit } = {
+    "segundo": "second",
+    "segundos": "second",
+    "min": "minute",
+    "mins": "minute",
+    "minuto": "minute",
+    "minutos": "minute",
+    "hora": "hour",
+    "horas": "hour",
+    "dia": "day",
+    "dias": "day",
+    "semana": "week",
+    "semanas": "week",
+    "mês": "month",
+    "mes": "month",
+    "meses": "month",
+    "trimestre": "quarter",
+    "trimestres": "quarter",
+    "ano": "year",
+    "anos": "year",
+};
+
+export const NUMBER_PATTERN = `(?:${matchAnyPattern(
+    INTEGER_WORD_DICTIONARY
+)}|[0-9]+[\\.,][0-9]+|[0-9]+|meia|meio|alguns|algumas)`;
+
+export function parseNumberPattern(match: string): number {
+    const num = match.toLowerCase();
+    if (INTEGER_WORD_DICTIONARY[num] !== undefined) {
+        return INTEGER_WORD_DICTIONARY[num];
+    } else if (num === "meia" || num === "meio") {
+        return 0.5;
+    } else if (num === "alguns" || num === "algumas") {
+        return 3;
+    }
+    return parseFloat(num.replace(",", "."));
+}
+
+const SINGLE_TIME_UNIT_PATTERN = `(${NUMBER_PATTERN})\\s{0,5}(${matchAnyPattern(TIME_UNIT_DICTIONARY)})\\s{0,5}`;
+const SINGLE_TIME_UNIT_REGEX = new RegExp(SINGLE_TIME_UNIT_PATTERN, "i");
+
+export const TIME_UNITS_PATTERN = repeatedTimeunitPattern("", SINGLE_TIME_UNIT_PATTERN, "\\s{0,5},?(?:\\s*e)?\\s{0,5}");
+
+export function parseDuration(timeunitText: string): null | Duration {
+    const fragments = {};
+    let remainingText = timeunitText;
+    let match = SINGLE_TIME_UNIT_REGEX.exec(remainingText);
+    while (match) {
+        const num = parseNumberPattern(match[1]);
+        const unit = TIME_UNIT_DICTIONARY[match[2].toLowerCase()];
+        fragments[unit] = num;
+        remainingText = remainingText.substring(match.index + match[0].length);
+        match = SINGLE_TIME_UNIT_REGEX.exec(remainingText);
+    }
+    if (Object.keys(fragments).length == 0) {
+        return null;
+    }
+    return fragments as Duration;
+}
