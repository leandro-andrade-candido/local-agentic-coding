+++ b/test/pt/pt_time_units.test.ts
@@ -0,0 +1,37 @@
+import * as chrono from "../../src/";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Time units ago", function () {
+    testSingleCase(chrono.pt, "Recebi o pedido há 3 dias", new Date(2012, 7, 10, 12, 14), (result) => {
+        expect(result.index).toBe(16);
+        expect(result.text).toBe("há 3 dias");
+        expect(result.start).toBeDate(new Date(2012, 7, 7, 12, 14));
+    });
+
+    testSingleCase(chrono.pt, "5 minutos atrás", new Date(2012, 7, 10, 12, 14), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 7, 10, 12, 9));
+    });
+
+    testSingleCase(chrono.pt, "faz duas semanas", new Date(2012, 7, 10, 12, 14), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 6, 27, 12, 14));
+    });
+});
+
+test("Test - Time units later", function () {
+    testSingleCase(chrono.pt, "daqui a 2 semanas", new Date(2012, 7, 10, 12, 14), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 7, 24, 12, 14));
+    });
+
+    testSingleCase(chrono.pt, "em meia hora", new Date(2012, 7, 10, 12, 14), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 7, 10, 12, 44));
+    });
+
+    testSingleCase(chrono.pt.strict, "dentro de 1 hora e 30 minutos", new Date(2012, 7, 10, 12, 14), (result) => {
+        expect(result.start).toBeDate(new Date(2012, 7, 10, 13, 44));
+    });
+});
+
+test("Test - Negative cases", function () {
+    testUnexpectedResult(chrono.pt, "há muito tempo");
+    testUnexpectedResult(chrono.pt, "em 2015");
+});
