@@ -0,0 +1,59 @@
+import unittest
+
+from pypika import Field, MySQLQuery, PostgreSQLQuery, Query, Table
+from pypika.utils import QueryException
+
+
+class CreateViewTests(unittest.TestCase):
+    select = Query.from_("orders").select("id", "total").where(Field("status") == "paid")
+
+    def test_create_view(self):
+        q = Query.create_view("v_paid").as_select(self.select)
+        self.assertEqual(
+            'CREATE VIEW "v_paid" AS SELECT "id","total" FROM "orders" WHERE "status"=\'paid\'', str(q)
+        )
+
+    def test_without_query_is_empty(self):
+        self.assertEqual("", str(Query.create_view("v_paid")))
+
+    def test_columns_and_or_replace(self):
+        q = Query.create_view("v").or_replace().columns("a", "b").as_select(self.select)
+        self.assertTrue(str(q).startswith('CREATE OR REPLACE VIEW "v" ("a","b") AS SELECT'))
+
+    def test_temporary_and_if_not_exists(self):
+        self.assertTrue(str(Query.create_view("v").temporary().as_select(self.select)).startswith("CREATE TEMPORARY VIEW"))
+        self.assertTrue(
+            str(Query.create_view(Table("v", schema="s")).if_not_exists().as_select(self.select)).startswith(
+                'CREATE VIEW IF NOT EXISTS "s"."v" AS'
+            )
+        )
+
+    def test_conflicts(self):
+        with self.assertRaises(QueryException):
+            Query.create_view("v").or_replace().if_not_exists()
+        with self.assertRaises(QueryException):
+            Query.create_view("v").if_not_exists().or_replace()
+
+    def test_as_select_requires_query(self):
+        with self.assertRaises(TypeError):
+            Query.create_view("v").as_select("SELECT 1")
+
+    def test_immutable(self):
+        base = Query.create_view("v")
+        base.or_replace()
+        base.columns("x")
+        self.assertEqual('CREATE VIEW "v" AS SELECT 1', str(base.as_select(Query.select(1))))
+
+    def test_mysql(self):
+        q = MySQLQuery.create_view("v").as_select(MySQLQuery.from_("t").select("a"))
+        self.assertEqual("CREATE VIEW `v` AS SELECT `a` FROM `t`", str(q))
+
+    def test_postgresql_materialized(self):
+        q = PostgreSQLQuery.create_view("mv").materialized().as_select(PostgreSQLQuery.from_("t").select("a"))
+        self.assertEqual('CREATE MATERIALIZED VIEW "mv" AS SELECT "a" FROM "t"', str(q))
+        with self.assertRaises(QueryException):
+            PostgreSQLQuery.create_view("mv").materialized().or_replace()
+        with self.assertRaises(QueryException):
+            PostgreSQLQuery.create_view("mv").temporary().materialized()
+        with self.assertRaises(AttributeError):
+            Query.create_view("v").materialized()
