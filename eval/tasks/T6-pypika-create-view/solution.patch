+class CreateViewBuilder:
+    """
+    Query builder used to build CREATE VIEW queries.
+
+    Syntax: CREATE [OR REPLACE] [TEMPORARY | MATERIALIZED] VIEW [IF NOT EXISTS] name [(columns)] AS query
+    """
+
+    QUOTE_CHAR = '"'
+    SECONDARY_QUOTE_CHAR = "'"
+    ALIAS_QUOTE_CHAR = None
+    QUERY_CLS = Query
+
+    def __init__(self, dialect: Dialects | None = None) -> None:
+        self._view = None
+        self._columns = []
+        self._as_select = None
+        self._or_replace = False
+        self._temporary = False
+        self._materialized = False
+        self._if_not_exists = False
+        self.dialect = dialect
+
+    def _set_kwargs_defaults(self, kwargs: dict) -> None:
+        kwargs.setdefault("quote_char", self.QUOTE_CHAR)
+        kwargs.setdefault("secondary_quote_char", self.SECONDARY_QUOTE_CHAR)
+        kwargs.setdefault("dialect", self.dialect)
+
+    @builder
+    def create_view(self, view: str | Table) -> None:
+        """
+        Sets the view to be created.
+
+        :raises AttributeError:
+            If the view is already set.
+        """
+        if self._view:
+            raise AttributeError("'Query' object already has attribute create_view")
+
+        self._view = view if isinstance(view, Table) else Table(view)
+
+    @builder
+    def columns(self, *columns: str | Column) -> None:
+        """
+        Sets the column names of the view.
+        """
+        # A new list keeps copies made by @builder independent from each other.
+        self._columns = self._columns + [
+            column if isinstance(column, Column) else Column(column) for column in columns
+        ]
+
+    @builder
+    def as_select(self, query_builder: QueryBuilder) -> None:
+        """
+        Sets the query that defines the view.
+
+        :raises TypeError:
+            If ``query_builder`` is not a query builder.
+        """
+        if not isinstance(query_builder, (QueryBuilder, _SetOperation)):
+            raise TypeError("Expected 'query_builder' to be instance of QueryBuilder")
+
+        self._as_select = query_builder
+
+    @builder
+    def or_replace(self) -> None:
+        """
+        Creates the view with CREATE OR REPLACE.
+
+        :raises QueryException:
+            If combined with IF NOT EXISTS or with a materialized view.
+        """
+        if self._if_not_exists:
+            raise QueryException("OR REPLACE cannot be combined with IF NOT EXISTS")
+        if self._materialized:
+            raise QueryException("OR REPLACE cannot be used with a materialized view")
+
+        self._or_replace = True
+
+    @builder
+    def temporary(self) -> None:
+        """
+        Makes the view temporary.
+
+        :raises QueryException:
+            If the view is materialized.
+        """
+        if self._materialized:
+            raise QueryException("A materialized view cannot be temporary")
+
+        self._temporary = True
+
+    @builder
+    def if_not_exists(self) -> None:
+        """
+        Adds IF NOT EXISTS.
+
+        :raises QueryException:
+            If combined with OR REPLACE.
+        """
+        if self._or_replace:
+            raise QueryException("IF NOT EXISTS cannot be combined with OR REPLACE")
+
+        self._if_not_exists = True
+
+    def get_sql(self, **kwargs: Any) -> str:
+        """
+        Gets the sql statement string.
+
+        :return: The create view statement, or an empty string while the view or its query is missing.
+        :rtype: str
+        """
+        self._set_kwargs_defaults(kwargs)
+
+        if not self._view or self._as_select is None:
+            return ""
+
+        columns = ""
+        if self._columns:
+            columns = " ({})".format(",".join(column.get_name_sql(**kwargs) for column in self._columns))
+
+        if self._materialized:
+            kind = "MATERIALIZED "
+        elif self._temporary:
+            kind = "TEMPORARY "
+        else:
+            kind = ""
+
+        # The inner query keeps its own dialect settings, so it renders exactly as str(query).
+        return "CREATE {or_replace}{kind}VIEW {if_not_exists}{view}{columns} AS {query}".format(
+            or_replace="OR REPLACE " if self._or_replace else "",
+            kind=kind,
+            if_not_exists="IF NOT EXISTS " if self._if_not_exists else "",
+            view=self._view.get_sql(**kwargs),
+            columns=columns,
+            query=self._as_select.get_sql(),
+        )
+
+    def __str__(self) -> str:
+        return self.get_sql()
+
+    def __repr__(self) -> str:
+        return self.__str__()
+
+
