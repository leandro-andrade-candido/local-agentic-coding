{
  "id": "T1",
  "title": "Explain the chrono architecture",
  "repo": "chrono",
  "category": "architecture",
  "plan_task": "T1 - explain the architecture of an unfamiliar repository",
  "timeout_min": 30,
  "notes": "The upstream AGENTS.md is removed during setup (it contains an architecture summary). Success = grade >= 7 on rubric.md, given afterwards.",
  "checks": [
    {
      "type": "unchanged",
      "name": "code_unchanged",
      "paths": [
        "src",
        "test"
      ]
    },
    {
      "type": "report",
      "name": "document_exists",
      "file": [
        "ARCHITECTURE.md",
        "architecture.md"
      ],
      "min_words": 300
    },
    {
      "type": "rubric",
      "name": "rubric",
      "rubric": "rubric.md",
      "report": [
        "ARCHITECTURE.md",
        "architecture.md"
      ],
      "threshold": 7,
      "max": 10,
      "hints": [
        [
          "src/index.ts"
        ],
        [
          "chrono.ts"
        ],
        [
          "innerPattern",
          "innerExtract",
          "executeParser"
        ],
        [
          "AbstractParserWithWordBoundary"
        ],
        [
          "isCertain",
          "imply",
          "impliedValues",
          "knownValues"
        ],
        [
          "MergeDateTime",
          "MergeDateRange",
          "OverlapRemoval"
        ],
        [
          "includeCommonConfiguration",
          "createCasualConfiguration"
        ],
        [
          "constants.ts"
        ],
        [
          "timezone.ts",
          "TIMEZONE_ABBR_MAP"
        ],
        [
          "testSingleCase",
          "test_util"
        ]
      ]
    }
  ]
}
