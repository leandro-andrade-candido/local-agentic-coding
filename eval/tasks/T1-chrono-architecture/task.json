{
  "id": "T1",
  "title": "Explicar a arquitetura do chrono",
  "repo": "chrono",
  "category": "architecture",
  "plan_task": "T1 - explicar a arquitetura de um repositório desconhecido",
  "timeout_min": 30,
  "notes": "AGENTS.md do upstream é removido no setup (contém um resumo da arquitetura). Sucesso = nota >= 7 no rubric.md, dada depois.",
  "checks": [
    {
      "type": "unchanged",
      "name": "codigo_inalterado",
      "paths": [
        "src",
        "test"
      ]
    },
    {
      "type": "report",
      "name": "documento_existe",
      "file": [
        "ARQUITETURA.md",
        "arquitetura.md"
      ],
      "min_words": 300
    },
    {
      "type": "rubric",
      "name": "gabarito",
      "rubric": "rubric.md",
      "report": [
        "ARQUITETURA.md",
        "arquitetura.md"
      ],
      "threshold": 7,
      "max": 10,
      "hints": [
        [
          "src/index.ts"
        ],
        [
          "chrono.ts"
        ],
        [
          "innerPattern",
          "innerExtract",
          "executeParser"
        ],
        [
          "AbstractParserWithWordBoundary"
        ],
        [
          "isCertain",
          "imply",
          "impliedValues",
          "knownValues"
        ],
        [
          "MergeDateTime",
          "MergeDateRange",
          "OverlapRemoval"
        ],
        [
          "includeCommonConfiguration",
          "createCasualConfiguration"
        ],
        [
          "constants.ts"
        ],
        [
          "timezone.ts",
          "TIMEZONE_ABBR_MAP"
        ],
        [
          "testSingleCase",
          "test_util"
        ]
      ]
    }
  ]
}
