@@ -1101,6 +1101,24 @@ class QueryBuilder(Selectable, Term):
     def offset(self, offset: int) -> None:
         self._offset = offset
 
+    @builder
+    def paginate(self, page: int, per_page: int) -> None:
+        """
+        Sets LIMIT and OFFSET from a 1-based page number.
+
+        :param page:
+            The page number, starting at 1.
+        :param per_page:
+            The number of rows per page.
+
+        :raises QueryException:
+            If ``page`` or ``per_page`` is smaller than 1.
+        """
+        if page < 1 or per_page < 1:
+            raise QueryException("page and per_page must be positive integers")
+        self._limit = per_page
+        self._offset = (page - 1) * per_page
+
     @builder
     def union(self, other: QueryBuilder) -> _SetOperation:
         return _SetOperation(self, other, SetOperation.union, wrapper_cls=self._wrapper_cls)
