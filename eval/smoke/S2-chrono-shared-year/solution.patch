@@ -31,3 +31,26 @@ export function findYearClosestToRef(refDate: Date, day: number, month: number):
     }
     return date.getFullYear();
 }
+
+/**
+ * Year with an optional era suffix, as written in Spanish and Portuguese:
+ * "2012", "88 a.C.", "234 AC", "1 d.C.".
+ */
+export const YEAR_WITH_ERA_PATTERN = "[0-9]{1,4}(?![^\\s]\\d)(?:\\s*[a|d]\\.?\\s*c\\.?|\\s*a\\.?\\s*d\\.?)?";
+
+/**
+ * Parses a year matched by {@link YEAR_WITH_ERA_PATTERN}. Two-digit years go to the most
+ * likely century and "a.C." (antes de Cristo) years become negative.
+ */
+export function parseYearWithEra(match: string): number {
+    if (match.match(/^[0-9]{1,4}$/)) {
+        return findMostLikelyADYear(parseInt(match));
+    }
+
+    if (match.match(/a\.?\s*c\.?/i)) {
+        match = match.replace(/a\.?\s*c\.?/i, "");
+        return -parseInt(match);
+    }
+
+    return parseInt(match);
+}
